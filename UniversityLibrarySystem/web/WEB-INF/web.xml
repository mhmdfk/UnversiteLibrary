<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>controller.AuthController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BookController</servlet-name>
        <servlet-class>controller.BookController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BorrowController</servlet-name>
        <servlet-class>controller.BorrowController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminController</servlet-name>
        <servlet-class>controller.AdminController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FineController</servlet-name>
        <servlet-class>controller.FineController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReturnController</servlet-name>
        <servlet-class>controller.ReturnController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CommentController</servlet-name>
        <servlet-class>controller.CommentController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RatingController</servlet-name>
        <servlet-class>controller.RatingController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SharedBooksController</servlet-name>
        <servlet-class>controller.SharedBooksController</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PatronController</servlet-name>
        <servlet-class>controller.PatronController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/auth/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BookController</servlet-name>
        <url-pattern>/book/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BorrowController</servlet-name>
        <url-pattern>/borrow</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FineController</servlet-name>
        <url-pattern>/fine</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReturnController</servlet-name>
        <url-pattern>/return</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CommentController</servlet-name>
        <url-pattern>/comment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RatingController</servlet-name>
        <url-pattern>/rating</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SharedBooksController</servlet-name>
        <url-pattern>/shared-books</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PatronController</servlet-name>
        <url-pattern>/patron/*</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <context-param>
        <param-name>fineRatePerDay</param-name>
        <param-value>1.0</param-value>
    </context-param>
    <context-param>
        <param-name>maxBooksPerPatron</param-name>
        <param-value>3</param-value>
    </context-param>
    <context-param>
        <param-name>defaultBorrowingPeriodInDays</param-name>
        <param-value>14</param-value>
    </context-param>
</web-app>
